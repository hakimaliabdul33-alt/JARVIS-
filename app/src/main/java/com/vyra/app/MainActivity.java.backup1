package com.vyra.app;

import android.app.Activity;
import android.os.Bundle;
import android.graphics.Color;
import android.graphics.Typeface;
import android.view.Gravity;
import android.view.View;
import android.widget.LinearLayout;
import android.widget.TextView;

public class MainActivity extends Activity {

    private LinearLayout content;
    private int purple = Color.rgb(124, 58, 237);
    private int text = Color.rgb(17, 24, 39);
    private int secondary = Color.rgb(107, 114, 128);

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        showHome();
    }

    private TextView label(String value, float size, int color) {
        TextView v = new TextView(this);
        v.setText(value);
        v.setTextSize(size);
        v.setTextColor(color);
        v.setPadding(20, 16, 20, 16);
        return v;
    }

    private TextView navItem(String icon, String name) {
        TextView v = label(icon + "\n" + name, 11, secondary);
        v.setGravity(Gravity.CENTER);
        v.setLayoutParams(new LinearLayout.LayoutParams(0, -1, 1));
        return v;
    }

    private void showHome() {
        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setBackgroundColor(Color.WHITE);
        root.setPadding(0, 28, 0, 0);

        LinearLayout top = new LinearLayout(this);
        top.setGravity(Gravity.CENTER_VERTICAL);

        TextView logo = label("VYRA", 28, purple);
        logo.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        top.addView(logo, new LinearLayout.LayoutParams(0, -2, 1));

        TextView add = label("＋", 30, text);
        add.setGravity(Gravity.CENTER);
        top.addView(add, new LinearLayout.LayoutParams(60, 70));

        root.addView(top);

        content = new LinearLayout(this);
        content.setOrientation(LinearLayout.VERTICAL);
        content.setPadding(16, 10, 16, 10);

        TextView welcome = label("Your Feed", 24, text);
        welcome.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(welcome);

        TextView info = label(
                "Videos, photos and updates from people you follow.",
                15, secondary);
        content.addView(info);

        TextView empty = label(
                "\n\nNo posts yet\n\nFollow people and creators to see their posts here.",
                17, secondary);
        empty.setGravity(Gravity.CENTER);
        content.addView(empty);

        root.addView(content, new LinearLayout.LayoutParams(
                -1, 0, 1));

        LinearLayout nav = new LinearLayout(this);
        nav.setGravity(Gravity.CENTER);
        nav.setBackgroundColor(Color.WHITE);

        TextView home = navItem("⌂", "Home");
        TextView shorts = navItem("▶", "Shorts");
        TextView search = navItem("⌕", "Search");
        TextView notify = navItem("♡", "Activity");
        TextView profile = navItem("●", "Profile");

        home.setTextColor(purple);

        nav.addView(home);
        nav.addView(shorts);
        nav.addView(search);
        nav.addView(notify);
        nav.addView(profile);

        root.addView(nav, new LinearLayout.LayoutParams(-1, 90));

        shorts.setOnClickListener(v -> showMessage("Shorts"));
        search.setOnClickListener(v -> showMessage("Search"));
        notify.setOnClickListener(v -> showMessage("Notifications"));
        profile.setOnClickListener(v -> showProfile());

        setContentView(root);
    }


    private void showProfile() {
        content.removeAllViews();

        TextView heading = label("Profile", 28, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        TextView name = label("VYRA User", 22, text);
        name.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(name);

        content.addView(label("@vyra_user", 15, secondary));
        content.addView(label("0 Followers    •    0 Following", 15, secondary));

        TextView bio = label("\nShare your world on VYRA.", 16, text);
        content.addView(bio);

        TextView settings = label("\n⚙  Settings", 18, text);
        settings.setOnClickListener(v -> showSettings());
        content.addView(settings);
    }

    private void showSettings() {
        content.removeAllViews();

        TextView heading = label("Settings", 28, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        TextView appearance = label("🎨  Appearance", 18, text);
        content.addView(appearance);

        TextView theme = label("   Light / Dark theme", 16, secondary);
        content.addView(theme);

        TextView color = label("   App color", 16, secondary);
        content.addView(color);

        TextView privacy = label("🔒  Privacy", 18, text);
        content.addView(privacy);

        TextView notifications = label("🔔  Notifications", 18, text);
        content.addView(notifications);

        TextView account = label("👤  Account", 18, text);
        content.addView(account);

        TextView language = label("🌐  Language", 18, text);
        content.addView(language);
    }

    private void showMessage(String title) {
        content.removeAllViews();

        TextView heading = label(title, 26, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        TextView message = label(
                "\nThis section is ready for the next VYRA feature.",
                16, secondary);
        content.addView(message);
    }
}
