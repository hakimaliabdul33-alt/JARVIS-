        android.widget.Switch privateSwitch = new android.widget.Switch(this);
        privateSwitch.setText("Private Account");
        privateSwitch.setTextSize(16);
        privateSwitch.setChecked(privateAccount);
        privateSwitch.setPadding(20, 12, 20, 12);
        content.addView(privateSwitch);

        privateSwitch.setOnCheckedChangeListener((buttonView, isChecked) -> {
