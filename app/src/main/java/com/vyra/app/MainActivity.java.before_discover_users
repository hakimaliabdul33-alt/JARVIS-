        notificationSwitch.setPadding(20, 12, 20, 12);
        content.addView(notificationSwitch);

        TextView account = label("👤  Account", 18, text);
        content.addView(account);

        Button editAccount = new Button(this);
        editAccount.setText("✏  Edit Account");
        editAccount.setTextSize(16);
        content.addView(editAccount);

        editAccount.setOnClickListener(v -> {
            android.widget.EditText usernameInput = new android.widget.EditText(this);
            usernameInput.setHint("Username");
            usernameInput.setSingleLine(true);

            new android.app.AlertDialog.Builder(this)
