        content.removeAllViews();

        TextView heading = label("Settings", 28, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        TextView appearance = label("🎨  Appearance", 18, text);
        content.addView(appearance);

        Button theme = new Button(this);
        theme.setText(darkMode ? "☀  Light Mode" : "🌙  Dark Mode");
        theme.setTextSize(16);
        content.addView(theme);

        theme.setOnClickListener(v -> {
            darkMode = !darkMode;
            applyTheme();
            showSettings();
        });

        Button color = new Button(this);
        color.setText("🎨  App Color");
        color.setTextSize(16);
        content.addView(color);

        color.setOnClickListener(v -> {
            String[] names = {"Purple", "Blue", "Green", "Orange", "Pink"};
            int[] colors = {
                Color.rgb(124, 58, 237),
                Color.rgb(37, 99, 235),
                Color.rgb(22, 163, 74),
                Color.rgb(234, 88, 12),
                Color.rgb(219, 39, 119)
