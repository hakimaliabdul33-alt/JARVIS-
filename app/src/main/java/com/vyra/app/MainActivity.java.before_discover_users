package com.vyra.app;

import android.app.Activity;
import android.content.Intent;
import android.content.SharedPreferences;
import android.net.Uri;
import android.widget.Button;
import android.widget.VideoView;
import android.widget.MediaController;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.Set;
import android.os.Bundle;
import android.graphics.Color;
import android.graphics.Typeface;
import android.view.Gravity;
import android.view.View;
import android.widget.LinearLayout;
import android.widget.TextView;

public class MainActivity extends Activity {

    private static final int PICK_SHORT_VIDEO = 1001;
    private static final int PICK_PROFILE_PHOTO = 1002;
    private Uri profilePhotoUri;

    private LinearLayout content;
    private int purple = Color.rgb(124, 58, 237);
    private int text = Color.rgb(17, 24, 39);
    private int secondary = Color.rgb(107, 114, 128);
    private boolean darkMode = false;
    private boolean privateAccount = false;
    private SharedPreferences profilePrefs;
    private String profileName = "VYRA User";
    private String profileBio = "Share your world on VYRA";
    private int followersCount = 0;
    private int followingCount = 0;
    private Set<String> followingUsers = new HashSet<>();
    private Set<String> followerUsers = new HashSet<>();

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        profilePrefs = getSharedPreferences("VYRA_PROFILE", MODE_PRIVATE);
        profileName = profilePrefs.getString("profileName", "VYRA User");
        profileBio = profilePrefs.getString("profileBio", "Share your world on VYRA");
        followersCount = profilePrefs.getInt("followersCount", 0);
        followingCount = profilePrefs.getInt("followingCount", 0);
        followingUsers = profilePrefs.getStringSet("followingUsers", new HashSet<String>());
        followerUsers = profilePrefs.getStringSet("followerUsers", new HashSet<String>());
        showHome();
    }

    private TextView label(String value, float size, int color) {
        TextView v = new TextView(this);
        v.setText(value);
        v.setTextSize(size);
        v.setTextColor(color);
        v.setPadding(20, 16, 20, 16);
        return v;
    }

    private TextView navItem(String icon, String name) {
        TextView v = label(icon + "\n" + name, 11, secondary);
        v.setGravity(Gravity.CENTER);
        v.setLayoutParams(new LinearLayout.LayoutParams(0, -1, 1));
        return v;
    }

    private void showHome() {
        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setBackgroundColor(Color.WHITE);
        root.setPadding(0, 28, 0, 0);

        LinearLayout top = new LinearLayout(this);
        top.setGravity(Gravity.CENTER_VERTICAL);

        TextView logo = label("VYRA", 28, purple);
        logo.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        top.addView(logo, new LinearLayout.LayoutParams(0, -2, 1));

        TextView add = label("＋", 30, text);
        add.setGravity(Gravity.CENTER);
        top.addView(add, new LinearLayout.LayoutParams(60, 70));

        root.addView(top);

        content = new LinearLayout(this);
        content.setOrientation(LinearLayout.VERTICAL);
        content.setPadding(16, 10, 16, 10);

        TextView welcome = label("Your Feed", 24, text);
        welcome.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(welcome);

        TextView info = label(
                "Videos, photos and updates from people you follow.",
                15, secondary);
        content.addView(info);

        TextView empty = label(
                "\n\nNo posts yet\n\nFollow people and creators to see their posts here.",
                17, secondary);
        empty.setGravity(Gravity.CENTER);
        content.addView(empty);

        root.addView(content, new LinearLayout.LayoutParams(
                -1, 0, 1));

        LinearLayout nav = new LinearLayout(this);
        nav.setGravity(Gravity.CENTER);
        nav.setBackgroundColor(Color.WHITE);

        TextView home = navItem("⌂", "Home");
        home.setOnClickListener(v -> showHome());

        TextView shorts = navItem("▶", "Shorts");
        TextView search = navItem("⌕", "Search");
        TextView notify = navItem("♡", "Activity");
        TextView profile = navItem("●", "Profile");

        home.setTextColor(purple);

        nav.addView(home);
        nav.addView(shorts);
        nav.addView(search);
        nav.addView(notify);
        nav.addView(profile);

        root.addView(nav, new LinearLayout.LayoutParams(-1, 90));

        shorts.setOnClickListener(v -> showShorts());
        search.setOnClickListener(v -> showSearch());
        notify.setOnClickListener(v -> showActivity());
        profile.setOnClickListener(v -> showProfile());

        setContentView(root);
    }


    private void showProfile() {
        content.removeAllViews();

        TextView heading = label("Profile", 28, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        android.widget.ImageView profilePhoto = new android.widget.ImageView(this);
        profilePhoto.setImageResource(android.R.drawable.ic_menu_camera);
        if (profilePhotoUri != null) {
            profilePhoto.setImageURI(profilePhotoUri);
            profilePhoto.setScaleType(android.widget.ImageView.ScaleType.CENTER_CROP);
        }
        if (profilePhotoUri == null) {
            profilePhoto.setScaleType(android.widget.ImageView.ScaleType.CENTER_INSIDE);
        }

        LinearLayout.LayoutParams photoParams =
                new LinearLayout.LayoutParams(220, 220);
        photoParams.gravity = Gravity.CENTER;
        profilePhoto.setLayoutParams(photoParams);
        content.addView(profilePhoto);

        profilePhoto.setOnClickListener(v -> {
            Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
            intent.setType("image/*");
            intent.addCategory(Intent.CATEGORY_OPENABLE);
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
            intent.addFlags(Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
            startActivityForResult(intent, PICK_PROFILE_PHOTO);
        });

        TextView photoHint = label("Tap photo to change", 14, secondary);
        photoHint.setGravity(Gravity.CENTER);
        content.addView(photoHint);

        Button removePhoto = new Button(this);
        removePhoto.setText("🗑  Remove Photo");
        removePhoto.setTextSize(15);
        content.addView(removePhoto);

        removePhoto.setOnClickListener(v -> {
            profilePhotoUri = null;
            showProfile();
        });

        TextView name = label(profileName, 22, text);
        name.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(name);

        content.addView(label("@vyra_user", 15, secondary));
        LinearLayout followStats = new LinearLayout(this);
        followStats.setOrientation(LinearLayout.HORIZONTAL);
        followStats.setGravity(Gravity.CENTER);
        Button followersButton = new Button(this);
        followersButton.setText(followersCount + " Followers");
        Button followingButton = new Button(this);
        followingButton.setText(followingCount + " Following");
        followStats.addView(followersButton, new LinearLayout.LayoutParams(0, -2, 1));
        followStats.addView(followingButton, new LinearLayout.LayoutParams(0, -2, 1));
        content.addView(followStats);
        followersButton.setOnClickListener(v -> showUserList("Followers", followerUsers));
        followingButton.setOnClickListener(v -> showUserList("Following", followingUsers));
        Button followButton = new Button(this);
        followButton.setText(followingUsers.contains("vyra_creator") ? "✓ Following" : "+ Follow");
        followButton.setTextSize(16);
        content.addView(followButton);

        followButton.setOnClickListener(v -> {
            String targetUser = "vyra_creator";

            if (followingUsers.contains(targetUser)) {
                followingUsers.remove(targetUser);
                followingCount = Math.max(0, followingCount - 1);
            } else {
                followingUsers.add(targetUser);
                followingCount++;
            }

            profilePrefs.edit()
                    .putInt("followingCount", followingCount)
                    .putStringSet("followingUsers", new HashSet<>(followingUsers))
                    .apply();

            showProfile();
        });

        TextView bio = label("\n" + profileBio, 16, text);
        content.addView(bio);

        Button editProfile = new Button(this);
        editProfile.setText("✏  Edit Profile");
        editProfile.setTextSize(16);
        content.addView(editProfile);

        editProfile.setOnClickListener(v -> {
            android.widget.EditText nameInput = new android.widget.EditText(this);
            nameInput.setHint("Name");
            nameInput.setText(profileName);

            android.widget.EditText bioInput = new android.widget.EditText(this);
            bioInput.setHint("Bio");
            bioInput.setText(profileBio);

            android.widget.LinearLayout box = new android.widget.LinearLayout(this);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.addView(nameInput);
            box.addView(bioInput);

            new android.app.AlertDialog.Builder(this)
                    .setTitle("Edit Profile")
                    .setView(box)
                    .setPositiveButton("Save", (dialog, which) -> {
                        String newName = nameInput.getText().toString().trim();
                        String newBio = bioInput.getText().toString().trim();
                        profileName = newName.isEmpty() ? profileName : newName;
                        profileBio = newBio.isEmpty() ? profileBio : newBio;
                        profilePrefs.edit().putString("profileName", profileName).putString("profileBio", profileBio).apply();
                        profilePrefs.edit().putInt("followersCount", followersCount).putInt("followingCount", followingCount).apply();

                        if (!newName.isEmpty()) {
                            name.setText(newName);
                        }

                        if (!newBio.isEmpty()) {
                            bio.setText("\n" + newBio);
                        }
                    })
                    .setNegativeButton("Cancel", null)
                    .show();
        });

        TextView settings = label("\n⚙  Settings", 18, text);
        settings.setOnClickListener(v -> showSettings());
        content.addView(settings);
    }

    private void showUserList(String title, Set<String> users) {
        content.removeAllViews();
        TextView heading = label(title, 28, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);
        if (users.isEmpty()) {
            content.addView(label("No " + title.toLowerCase() + " yet.", 16, secondary));
            return;
        }
        for (String username : users) {
            TextView user = label("👤  @" + username, 17, text);
            content.addView(user);
        }
    }

    private void applyTheme() {
        if (content == null) return;

        if (darkMode) {
            content.setBackgroundColor(Color.rgb(17, 24, 39));
            text = Color.rgb(243, 244, 246);
            secondary = Color.rgb(156, 163, 175);
        } else {
            content.setBackgroundColor(Color.WHITE);
            text = Color.rgb(17, 24, 39);
            secondary = Color.rgb(107, 114, 128);
        }
    }

