        TextView notifications = label("🔔  Notifications", 18, text);
        content.addView(notifications);

        android.widget.Switch notificationSwitch = new android.widget.Switch(this);
        notificationSwitch.setText("Allow Notifications");
        notificationSwitch.setTextSize(16);
