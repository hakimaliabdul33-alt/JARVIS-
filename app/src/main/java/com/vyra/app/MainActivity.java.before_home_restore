    private void uploadVideoToSupabase(
            Uri videoUri,
            String title,
            String category,
            String country,
            String language,
            final UploadCallback callback) {

        new Thread(() -> {
            try {
                String uid = firebaseAuth != null && firebaseAuth.getCurrentUser() != null
                        ? firebaseAuth.getCurrentUser().getUid()
                        : "guest";

                String safeTitle = title.replaceAll("[^a-zA-Z0-9_-]", "_");
                String path = "videos/" + uid + "/" + System.currentTimeMillis()
                        + "_" + safeTitle + ".mp4";

                String uploadUrl = SUPABASE_URL
                        + "/storage/v1/object/"
                        + SUPABASE_BUCKET + "/" + path;

                RequestBody body = new RequestBody() {
                    @Override
                    public okhttp3.MediaType contentType() {
                        return okhttp3.MediaType.parse("video/mp4");
                    }

                    @Override
                    public long contentLength() throws IOException {
                        try (android.database.Cursor cursor =
                                     getContentResolver().query(
                                             videoUri,
                                             null,
                                             null,
                                             null,
                                             null)) {

                            if (cursor != null) {
                                int sizeIndex = cursor.getColumnIndex(
                                        android.provider.OpenableColumns.SIZE
                                );

                                if (cursor.moveToFirst()
                                        && sizeIndex >= 0
                                        && !cursor.isNull(sizeIndex)) {
                                    return cursor.getLong(sizeIndex);
                                }
                            }
                        } catch (Exception ignored) {
                        }

                        return -1;
                    }

                    @Override
                    public void writeTo(BufferedSink sink) throws IOException {
                        try (InputStream input =
                                     getContentResolver().openInputStream(videoUri)) {

                            if (input == null) {
                                throw new IOException("Unable to open video.");
                            }

                            byte[] buffer = new byte[64 * 1024];
                            int read;

                            while ((read = input.read(buffer)) != -1) {
                                sink.write(buffer, 0, read);
                            }
                        }
                    }
                };

                Request request = new Request.Builder()
                        .url(uploadUrl)
                        .addHeader("apikey", SUPABASE_PUBLISHABLE_KEY)
                        .addHeader(
                                "Authorization",
                                "Bearer " + SUPABASE_PUBLISHABLE_KEY
                        )
                        .addHeader("Content-Type", "video/mp4")
                        .addHeader("x-upsert", "true")
                        .post(body)
                        .build();

                try (Response response =
                             supabaseHttpClient.newCall(request).execute()) {

                    if (!response.isSuccessful()) {
                        String error = response.body() != null
                                ? response.body().string()
                                : "HTTP " + response.code();

                        runOnUiThread(() ->
                                callback.onError(
                                        "Supabase upload failed: " + error
                                )
                        );
                        return;
                    }

                    String publicUrl = SUPABASE_URL
                            + "/storage/v1/object/public/"
                            + SUPABASE_BUCKET + "/" + path;

                    runOnUiThread(() ->
                            callback.onSuccess(publicUrl)
                    );
                }

            } catch (Exception e) {
                runOnUiThread(() ->
                        callback.onError(
                                e.getMessage() == null
                                        ? "Video upload failed."
                                        : e.getMessage()
                        )
                );
            }
        }).start();
    }

    private interface UploadCallback {
        void onSuccess(String publicUrl);
        void onError(String message);
    }

    private void exportTrimmedVideo(
            Uri sourceUri,
            long startMs,
            long endMs,
            final TrimExportCallback callback) {

        try {
            String fileName = "vyra_trim_" + System.currentTimeMillis() + ".mp4";
            java.io.File outputFile = new java.io.File(getCacheDir(), fileName);

            MediaItem mediaItem = new MediaItem.Builder()
                    .setUri(sourceUri)
                    .setMimeType(MimeTypes.VIDEO_MP4)
                    .setClipStartPositionMs(startMs)
                    .setClipEndPositionMs(endMs)
                    .build();

            Transformer transformer = new Transformer.Builder(this)
                    .setVideoMimeType(MimeTypes.VIDEO_H264)
                    .setAudioMimeType(MimeTypes.AUDIO_AAC)
                    .experimentalSetTrimOptimizationEnabled(true)
                    .addListener(new Transformer.Listener() {
                        @Override
                        public void onCompleted(
                                Composition composition,
                                androidx.media3.transformer.ExportResult exportResult) {
                            runOnUiThread(() ->
                                    callback.onSuccess(Uri.fromFile(outputFile))
                            );
                        }

                        @Override
                        public void onError(
                                Composition composition,
                                androidx.media3.transformer.ExportResult exportResult,
                                androidx.media3.transformer.ExportException exportException) {
                            runOnUiThread(() ->
                                    callback.onError(
                                            exportException.getMessage() == null
                                                    ? "Video export failed."
                                                    : exportException.getMessage()
                                    )
                            );
                        }
                    })
                    .build();

            transformer.start(mediaItem, outputFile.getAbsolutePath());

        } catch (Exception e) {
            callback.onError(
                    e.getMessage() == null
                            ? "Unable to start video export."
                            : e.getMessage()
            );
        }
    }

    private void exportVideoEffect(
            Uri sourceUri,
            float scaleX,
            float scaleY,
            float rotationDegrees,
            float brightness,
            float contrast,
            float blurSigma,
            final TrimExportCallback callback) {

        try {
            String fileName =
                    "vyra_effect_" + System.currentTimeMillis() + ".mp4";
            java.io.File outputFile =
                    new java.io.File(getCacheDir(), fileName);

            MediaItem mediaItem = new MediaItem.Builder()
                    .setUri(sourceUri)
                    .setMimeType(MimeTypes.VIDEO_MP4)
                    .build();

            androidx.media3.effect.ScaleAndRotateTransformation effect =
                    new androidx.media3.effect.ScaleAndRotateTransformation
                            .Builder()
                            .setScale(scaleX, scaleY)
                            .setRotationDegrees(rotationDegrees)
                            .build();

            java.util.List<androidx.media3.common.Effect> videoEffects =
                    new java.util.ArrayList<>();

            videoEffects.add(effect);

            if (brightness != 0.0f) {
                videoEffects.add(
                        new androidx.media3.effect.Brightness(brightness)
                );
            }

            if (contrast != 1.0f) {
                videoEffects.add(
                        new androidx.media3.effect.Contrast(contrast)
                );
            }

            if (blurSigma > 0.0f) {
                videoEffects.add(
                        new androidx.media3.effect.GaussianBlur(blurSigma)
                );
            }

            Effects effects = new Effects(
                    java.util.Collections.emptyList(),
                    videoEffects
            );

            EditedMediaItem editedMediaItem =
                    new EditedMediaItem.Builder(mediaItem)
                            .setEffects(effects)
                            .build();

            Transformer transformer = new Transformer.Builder(this)
                    .setVideoMimeType(MimeTypes.VIDEO_H264)
                    .setAudioMimeType(MimeTypes.AUDIO_AAC)
                    .addListener(new Transformer.Listener() {
                        @Override
                        public void onCompleted(
                                Composition composition,
                                androidx.media3.transformer.ExportResult exportResult) {

                            runOnUiThread(() ->
                                    callback.onSuccess(
                                            Uri.fromFile(outputFile)
                                    )
                            );
                        }

                        @Override
                        public void onError(
                                Composition composition,
                                androidx.media3.transformer.ExportResult exportResult,
                                androidx.media3.transformer.ExportException exportException) {

                            runOnUiThread(() ->
                                    callback.onError(
                                            exportException.getMessage() == null
                                                    ? "Effect export failed."
                                                    : exportException.getMessage()
                                    )
                            );
                        }
                    })
                    .build();

            transformer.start(editedMediaItem, outputFile.getAbsolutePath());

        } catch (Exception e) {
            callback.onError(
                    e.getMessage() == null
                            ? "Unable to start effect export."
                            : e.getMessage()
            );
        }
    }

