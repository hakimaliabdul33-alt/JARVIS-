        TextView heading = label("Notification", 28, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        TextView detail = label(
                "\n🔔  " + notification + "\n",
                18,
                text
        );
        detail.setPadding(12, 20, 12, 20);
        content.addView(detail);

        Button back = new Button(this);
        back.setText("← Back to Activity");
        back.setOnClickListener(v -> showActivity());
        content.addView(back);
    }

    private void showActivity() {
        content.removeAllViews();

        unreadNotifications = 0;
        profilePrefs.edit()
                .putInt("unreadNotifications", 0)
                .apply();

        TextView heading = label("Activity", 28, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        if (localNotifications.isEmpty()) {
            content.addView(
                    label("\n🔔  You're all caught up!", 16, secondary)
            );
            content.addView(
                    label("No new activity yet.", 15, secondary)
            );
            return;
        }

        for (int i = localNotifications.size() - 1; i >= 0; i--) {
            final String notification = localNotifications.get(i);

            TextView item = label(
                    "🔔  " + notification,
                    16,
                    text
            );
            item.setPadding(8, 18, 8, 18);
            item.setOnClickListener(v ->
                    showNotificationDetail(notification)
            );

            content.addView(item);
        }
    }

    private void showSearch() {
        content.removeAllViews();

        TextView heading = label("Discover Users", 28, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        TextView sub = label("Find real people on VYRA", 16, secondary);
        content.addView(sub);

        final EditText searchInput = new EditText(this);
        searchInput.setHint("Search username or name...");
        searchInput.setSingleLine(true);
        searchInput.setPadding(16, 12, 16, 12);
        content.addView(searchInput);

        LinearLayout results = new LinearLayout(this);
        results.setOrientation(LinearLayout.VERTICAL);
        content.addView(
                results,
                new LinearLayout.LayoutParams(-1, -2)
        );

        Runnable renderResults = () -> {
            results.removeAllViews();

            String query = searchInput.getText()
                    .toString()
                    .trim()
                    .toLowerCase();

            firestore.collection("users")
                    .get()
                    .addOnCompleteListener(task -> {
                        if (!task.isSuccessful()) {
                            results.addView(
                                    label(
                                            "Unable to load users. Check your connection.",
                                            15,
                                            secondary
                                    )
                            );
                            return;
                        }

                        int found = 0;

                        for (com.google.firebase.firestore.QueryDocumentSnapshot doc
                                : task.getResult()) {

                            String uid = doc.getString("uid");
                            String username = doc.getString("username");
                            String displayName = doc.getString("displayName");

                            if (uid == null) {
                                uid = doc.getId();
                            }

                            if (username == null || username.trim().isEmpty()) {
                                username = "vyrauser";
                            }

                            if (displayName == null || displayName.trim().isEmpty()) {
                                displayName = username;
                            }

                            if (firebaseAuth.getCurrentUser() != null
                                    && uid.equals(firebaseAuth.getCurrentUser().getUid())) {
                                continue;
                            }

                            String usernameLower = username.toLowerCase();
                            String displayNameLower = displayName.toLowerCase();

                            if (!query.isEmpty()
                                    && !usernameLower.contains(query)
                                    && !displayNameLower.contains(query)) {
                                continue;
                            }

                            found++;

                            final String finalUid = uid;
                            final String finalUsername = username;
                            final String finalDisplayName = displayName;

                            LinearLayout row = new LinearLayout(this);
                            row.setOrientation(LinearLayout.HORIZONTAL);
                            row.setGravity(Gravity.CENTER_VERTICAL);
                            row.setPadding(8, 14, 8, 14);
                            row.setClickable(true);

                            LinearLayout info = new LinearLayout(this);
                            info.setOrientation(LinearLayout.VERTICAL);

                            TextView nameView =
                                    label(finalDisplayName, 17, text);
                            nameView.setTypeface(
                                    Typeface.DEFAULT,
                                    Typeface.BOLD
                            );

                            TextView usernameView =
                                    label(
                                            "@" + finalUsername,
                                            14,
                                            secondary
                                    );

                            info.addView(nameView);
                            info.addView(usernameView);

                            View.OnClickListener openProfile =
                                    v -> showUserProfile(
                                            finalUid,
                                            finalUsername,
                                            finalDisplayName
                                    );

                            row.setOnClickListener(openProfile);
                            info.setOnClickListener(openProfile);
                            nameView.setOnClickListener(openProfile);
                            usernameView.setOnClickListener(openProfile);

                            Button follow = new Button(this);
                            follow.setText(
                                    followingUsers.contains(finalUsername)
                                            ? "✓ Following"
                                            : "+ Follow"
                            );

                            follow.setOnClickListener(v -> {
                                if (followingUsers.contains(finalUsername)) {
                                    followingUsers.remove(finalUsername);
                                    followingCount =
                                            Math.max(0, followingCount - 1);
                                    follow.setText("+ Follow");
                                } else {
                                    followingUsers.add(finalUsername);
                                    followingCount++;
                                    follow.setText("✓ Following");

                                    addNotification(
                                            "You followed @"
                                                    + finalUsername
                                                    + "."
                                    );
                                }

                                profilePrefs.edit()
                                        .putInt(
                                                "followingCount",
                                                followingCount
                                        )
                                        .putStringSet(
                                                "followingUsers",
                                                new HashSet<>(
                                                        followingUsers
                                                )
                                        )
                                        .apply();
                            });

                            row.addView(
                                    info,
                                    new LinearLayout.LayoutParams(
                                            0,
                                            -2,
                                            1
                                    )
                            );

                            row.addView(follow);
                            results.addView(row);
                        }

                        if (found == 0) {
                            results.addView(
                                    label(
                                            query.isEmpty()
                                                    ? "No other users yet."
                                                    : "No users found.",
                                            16,
                                            secondary
                                    )
                            );
                        }
                    });
        };

        searchInput.addTextChangedListener(
                new android.text.TextWatcher() {
                    @Override
                    public void beforeTextChanged(
                            CharSequence s,
                            int start,
                            int count,
                            int after) {
                    }

                    @Override
                    public void onTextChanged(
                            CharSequence s,
                            int start,
                            int before,
                            int count) {
                        renderResults.run();
                    }

                    @Override
                    public void afterTextChanged(
                            android.text.Editable s) {
                    }
                }
        );

        renderResults.run();
    }

    private void showUserProfile(String uid, String username, String displayName) {
        content.removeAllViews();

        Button back = new Button(this);
        back.setText("← Back");
        back.setOnClickListener(v -> showSearch());
        content.addView(back);

        TextView name = label(displayName, 28, text);
        name.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        name.setGravity(Gravity.CENTER);
        content.addView(name);

        TextView user = label("@" + username, 16, secondary);
        user.setGravity(Gravity.CENTER);
        content.addView(user);

        TextView bio = label("\nShare your world on VYRA", 16, text);
        bio.setGravity(Gravity.CENTER);
        content.addView(bio);

        LinearLayout stats = new LinearLayout(this);
        stats.setOrientation(LinearLayout.HORIZONTAL);
        stats.setGravity(Gravity.CENTER);

        TextView followers = label("0\nFollowers", 15, text);
        followers.setGravity(Gravity.CENTER);

        TextView following = label("0\nFollowing", 15, text);
        following.setGravity(Gravity.CENTER);

        stats.addView(followers, new LinearLayout.LayoutParams(0, -2, 1));
        stats.addView(following, new LinearLayout.LayoutParams(0, -2, 1));
        content.addView(stats);

        Button follow = new Button(this);
        follow.setText(followingUsers.contains(username) ? "✓ Following" : "+ Follow");
        follow.setTextSize(16);
        content.addView(follow);

        Button messageButton = new Button(this);
        messageButton.setText("✉ Message");
        messageButton.setTextSize(16);
        content.addView(messageButton);

        messageButton.setOnClickListener(v ->
                showChat(uid, username, displayName)
        );

        follow.setOnClickListener(v -> {
            if (followingUsers.contains(username)) {
                followingUsers.remove(username);
                followingCount = Math.max(0, followingCount - 1);
                follow.setText("+ Follow");
            } else {
                followingUsers.add(username);
                followingCount++;
                follow.setText("✓ Following");
                addNotification("You followed @" + username + ".");
            }

            profilePrefs.edit()
                    .putInt("followingCount", followingCount)
                    .putStringSet("followingUsers", new HashSet<>(followingUsers))
                    .apply();
        });

        content.addView(label("\nNo posts yet.", 16, secondary));
    }

    private void showMessage(String title) {
        content.removeAllViews();

        TextView heading = label("Comments", 26, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        LinearLayout inputRow = new LinearLayout(this);
        inputRow.setOrientation(LinearLayout.HORIZONTAL);
        inputRow.setGravity(Gravity.CENTER_VERTICAL);

        final android.widget.EditText input =
                new android.widget.EditText(this);
        input.setHint("Write a comment...");
        input.setSingleLine(true);

        Button send = new Button(this);
        send.setText("Send");

        inputRow.addView(input,
                new LinearLayout.LayoutParams(0, -2, 1));
        inputRow.addView(send);

        content.addView(inputRow);

        LinearLayout commentsList = new LinearLayout(this);
        commentsList.setOrientation(LinearLayout.VERTICAL);
        content.addView(commentsList);

        for (String commentText : localComments) {
            commentsList.addView(
                    label("👤  " + commentText, 16, text)
            );
        }

        if (localComments.isEmpty()) {
            commentsList.addView(
                    label("\nNo comments yet. Be the first to comment!",
                            16, secondary)
            );
        }

        send.setOnClickListener(v -> {
            String value = input.getText().toString().trim();

            if (value.isEmpty()) {
                return;
            }

            localComments.add(value);
            addNotification("You added a comment.");

            profilePrefs.edit()
                    .putStringSet(
                            "localComments",
                            new HashSet<>(localComments)
                    )
                    .apply();

            showMessage("Comments");
        });
    }
