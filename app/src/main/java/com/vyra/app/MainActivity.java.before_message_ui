        TextView share = overlayAction("⌁", "Share");
        TextView save = overlayAction(
                savedPosts.contains("local|" + title) ? "▣" : "□",
                "Save"
        );

        side.addView(like);
        side.addView(comment);
        side.addView(share);
        side.addView(save);
        frame.addView(side, sideParams);

        LinearLayout info = new LinearLayout(this);
        info.setOrientation(LinearLayout.VERTICAL);
        info.setPadding(18, 12, 18, 14);
        info.setBackgroundColor(Color.argb(215, 0, 0, 0));

        TextView author = label(profileName + "  ✓", 17, Color.WHITE);
        author.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        info.addView(author);
        info.addView(label("@" + profileUsername, 13, Color.LTGRAY));

        LinearLayout followRow = new LinearLayout(this);
        followRow.setGravity(Gravity.CENTER_VERTICAL);

        TextView music = label(
                "♫  Original sound • VYRA",
                13,
                Color.WHITE
        );
        followRow.addView(music, new LinearLayout.LayoutParams(0, -2, 1));

        Button follow = new Button(this);
        follow.setText("Follow");
        follow.setTextSize(12);
        followRow.addView(follow);

        info.addView(followRow);

        FrameLayout.LayoutParams infoParams =
                new FrameLayout.LayoutParams(-1, -2, Gravity.BOTTOM);
        frame.addView(info, infoParams);

        like.setOnClickListener(v -> {
            localVideoLiked = !localVideoLiked;
            if (localVideoLiked) {
