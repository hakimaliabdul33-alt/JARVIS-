            );

            profilePrefs.edit()
                    .putInt("localVideoLikes", localVideoLikes)
                    .putBoolean("localVideoLiked", localVideoLiked)
                    .apply();
        });

        comment.setOnClickListener(v -> showMessage("Comments"));

        share.setOnClickListener(v -> {
            Intent shareIntent = new Intent(Intent.ACTION_SEND);
            shareIntent.setType("text/plain");
            shareIntent.putExtra(
                    Intent.EXTRA_TEXT,
                    "Check this video on VYRA: " +
                    (title == null ? "My VYRA Video" : title)
            );
            startActivity(Intent.createChooser(shareIntent, "Share with"));
        });

        String saveKey = "local|" + title;
        save.setOnClickListener(v -> {
            if (savedPosts.contains(saveKey)) {
                savedPosts.remove(saveKey);
                save.setText("□\nSave");
            } else {
                savedPosts.add(saveKey);
                save.setText("▣\nSaved");
            }

            profilePrefs.edit()
                    .putStringSet("savedPosts", new HashSet<>(savedPosts))
                    .apply();
        });

