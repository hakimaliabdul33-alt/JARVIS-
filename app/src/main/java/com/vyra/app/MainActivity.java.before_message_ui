    private void showProfile() {
        content.removeAllViews();

        TextView heading = label("Profile", 28, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        android.widget.ImageView profilePhoto = new android.widget.ImageView(this);
        profilePhoto.setImageResource(android.R.drawable.ic_menu_camera);
        if (profilePhotoUri != null) {
            profilePhoto.setImageURI(profilePhotoUri);
            profilePhoto.setScaleType(android.widget.ImageView.ScaleType.CENTER_CROP);
        }
        if (profilePhotoUri == null) {
            profilePhoto.setScaleType(android.widget.ImageView.ScaleType.CENTER_INSIDE);
        }

        LinearLayout.LayoutParams photoParams =
                new LinearLayout.LayoutParams(220, 220);
        photoParams.gravity = Gravity.CENTER;
        profilePhoto.setLayoutParams(photoParams);
        content.addView(profilePhoto);

        profilePhoto.setOnClickListener(v -> {
            Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
            intent.setType("image/*");
            intent.addCategory(Intent.CATEGORY_OPENABLE);
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
            intent.addFlags(Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
            startActivityForResult(intent, PICK_PROFILE_PHOTO);
        });

        TextView photoHint = label("Tap photo to change", 14, secondary);
        photoHint.setGravity(Gravity.CENTER);
        content.addView(photoHint);

        Button removePhoto = new Button(this);
        removePhoto.setText("🗑  Remove Photo");
        removePhoto.setTextSize(15);
        content.addView(removePhoto);

        removePhoto.setOnClickListener(v -> {
            profilePhotoUri = null;

            profilePrefs.edit()
                    .remove("profilePhotoUri")
                    .apply();

            showProfile();
        });

        TextView name = label(profileName, 22, text);
        name.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(name);

        content.addView(label("@" + profileUsername, 15, secondary));
        LinearLayout followStats = new LinearLayout(this);
        followStats.setOrientation(LinearLayout.HORIZONTAL);
        followStats.setGravity(Gravity.CENTER);
        Button followersButton = new Button(this);
        followersButton.setText(followersCount + " Followers");
        Button followingButton = new Button(this);
        followingButton.setText(followingCount + " Following");
        followStats.addView(followersButton, new LinearLayout.LayoutParams(0, -2, 1));
        followStats.addView(followingButton, new LinearLayout.LayoutParams(0, -2, 1));
        content.addView(followStats);
        followersButton.setOnClickListener(v -> showUserList("Followers", followerUsers));
        followingButton.setOnClickListener(v -> showUserList("Following", followingUsers));
        Button followButton = new Button(this);
        followButton.setText(followingUsers.contains("vyra_creator") ? "✓ Following" : "+ Follow");
        followButton.setTextSize(16);
        content.addView(followButton);

        followButton.setOnClickListener(v -> {
            String targetUser = "vyra_creator";

            if (followingUsers.contains(targetUser)) {
                followingUsers.remove(targetUser);
                followingCount = Math.max(0, followingCount - 1);
            } else {
                followingUsers.add(targetUser);
                followingCount++;
                addNotification("You followed @" + targetUser + ".");
            }

            profilePrefs.edit()
                    .putInt("followingCount", followingCount)
                    .putStringSet("followingUsers", new HashSet<>(followingUsers))
                    .apply();

            showProfile();
        });

        TextView bio = label("\n" + profileBio, 16, text);
        content.addView(bio);

        Button editProfile = new Button(this);
        editProfile.setText("✏  Edit Profile");
        editProfile.setTextSize(16);
        content.addView(editProfile);

        editProfile.setOnClickListener(v -> {
            android.widget.EditText nameInput = new android.widget.EditText(this);
            nameInput.setHint("Name");
            nameInput.setText(profileName);

            android.widget.EditText bioInput = new android.widget.EditText(this);
            bioInput.setHint("Bio");
            bioInput.setText(profileBio);

            android.widget.LinearLayout box = new android.widget.LinearLayout(this);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.addView(nameInput);
            box.addView(bioInput);

            new android.app.AlertDialog.Builder(this)
                    .setTitle("Edit Profile")
                    .setView(box)
                    .setPositiveButton("Save", (dialog, which) -> {
                        String newName = nameInput.getText().toString().trim();
                        String newBio = bioInput.getText().toString().trim();
                        profileName = newName.isEmpty() ? profileName : newName;
                        profileBio = newBio.isEmpty() ? profileBio : newBio;

                        if (!newName.isEmpty()) {
                            profileUsername = generateUsername(profileName);
                        }

                        profilePrefs.edit()
                                .putString("profileName", profileName)
                                .putString("profileUsername", profileUsername)
                                .putString("profileBio", profileBio)
                                .apply();
                        profilePrefs.edit().putInt("followersCount", followersCount).putInt("followingCount", followingCount).apply();

                        if (!newName.isEmpty()) {
                            name.setText(newName);
                        }

                        if (!newBio.isEmpty()) {
                            bio.setText("\n" + newBio);
                        }
                    })
                    .setNegativeButton("Cancel", null)
                    .show();
        });

        TextView settings = label("\n⚙  Settings", 18, text);
        settings.setOnClickListener(v -> showSettings());
        content.addView(settings);
    }

    private void showUserList(String title, Set<String> users) {
        content.removeAllViews();

        TextView heading = label(title, 28, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        Button back = new Button(this);
        back.setText("← Back to Profile");
        back.setOnClickListener(v -> showProfile());
        content.addView(back);

        if (users.isEmpty()) {
            content.addView(
                    label(
                            "No " + title.toLowerCase() + " yet.",
                            16,
                            secondary
                    )
            );
            return;
        }

        for (String username : users) {
            LinearLayout row = new LinearLayout(this);
            row.setOrientation(LinearLayout.HORIZONTAL);
            row.setGravity(Gravity.CENTER_VERTICAL);
            row.setPadding(8, 14, 8, 14);

            TextView user = label(
                    "👤  @" + username,
                    17,
                    text
            );

            Button follow = new Button(this);
            boolean isFollowing = followingUsers.contains(username);
            follow.setText(isFollowing ? "✓ Following" : "+ Follow");

            follow.setOnClickListener(v -> {
                if (followingUsers.contains(username)) {
                    followingUsers.remove(username);
                    followingCount =
                            Math.max(0, followingCount - 1);
                    follow.setText("+ Follow");
                } else {
                    followingUsers.add(username);
                    followingCount++;
                    follow.setText("✓ Following");
                    addNotification(
                            "You followed @" + username + "."
                    );
                }

                profilePrefs.edit()
                        .putInt("followingCount", followingCount)
                        .putStringSet(
                                "followingUsers",
                                new HashSet<>(followingUsers)
                        )
                        .apply();
            });

            row.addView(
                    user,
                    new LinearLayout.LayoutParams(0, -2, 1)
            );
            row.addView(follow);
            content.addView(row);
        }
    }

    private void applyTheme() {
        if (content == null) return;

        if (darkMode) {
            content.setBackgroundColor(Color.rgb(17, 24, 39));
            text = Color.rgb(243, 244, 246);
            secondary = Color.rgb(156, 163, 175);
        } else {
            content.setBackgroundColor(Color.WHITE);
            text = Color.rgb(17, 24, 39);
            secondary = Color.rgb(107, 114, 128);
        }
    }

    private void showSettings() {
