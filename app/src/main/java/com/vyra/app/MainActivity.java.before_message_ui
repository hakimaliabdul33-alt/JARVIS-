    private void showSearch() {
        content.removeAllViews();

        TextView heading = label("Discover Users", 28, text);
        heading.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        content.addView(heading);

        TextView sub = label("Find people to follow on VYRA", 16, secondary);
        content.addView(sub);

        final android.widget.EditText searchInput =
                new android.widget.EditText(this);
        searchInput.setHint("Search users...");
        searchInput.setSingleLine(true);
        searchInput.setPadding(16, 12, 16, 12);
        content.addView(searchInput);

        String[][] users = {
            {"vyra_creator", "VYRA Creator"},
            {"travel_vyra", "Travel VYRA"},
            {"foodie_vyra", "Foodie VYRA"},
            {"tech_vyra", "Tech VYRA"},
            {"music_vyra", "Music VYRA"}
        };

        LinearLayout results = new LinearLayout(this);
        results.setOrientation(LinearLayout.VERTICAL);
        content.addView(results);

        Runnable renderResults = () -> {
            results.removeAllViews();

            String query = searchInput.getText().toString()
                    .trim()
                    .toLowerCase();

            int found = 0;

            for (String[] userData : users) {
                String username = userData[0];
                String displayName = userData[1];

                if (!query.isEmpty()
                        && !username.toLowerCase().contains(query)
                        && !displayName.toLowerCase().contains(query)) {
                    continue;
                }

                found++;

                LinearLayout row = new LinearLayout(this);
                row.setOrientation(LinearLayout.HORIZONTAL);
                row.setGravity(Gravity.CENTER_VERTICAL);
                row.setPadding(8, 18, 8, 18);

                LinearLayout info = new LinearLayout(this);
                info.setOrientation(LinearLayout.VERTICAL);

                TextView nameView = label(displayName, 17, text);
                nameView.setTypeface(Typeface.DEFAULT, Typeface.BOLD);

                TextView usernameView =
                        label("@" + username, 14, secondary);

                info.addView(nameView);
                info.addView(usernameView);

                View.OnClickListener openProfile =
                        v -> showUserProfile(username, displayName);

                nameView.setOnClickListener(openProfile);
                usernameView.setOnClickListener(openProfile);
                info.setOnClickListener(openProfile);

                Button follow = new Button(this);
                follow.setText(
                        followingUsers.contains(username)
                                ? "✓ Following"
                                : "+ Follow"
                );

                follow.setOnClickListener(v -> {
                    if (followingUsers.contains(username)) {
                        followingUsers.remove(username);
                        followingCount =
                                Math.max(0, followingCount - 1);
                        follow.setText("+ Follow");
                    } else {
                        followingUsers.add(username);
                        followingCount++;
                        follow.setText("✓ Following");
                        addNotification(
                                "You followed @" + username + "."
                        );
                    }

                    profilePrefs.edit()
                            .putInt("followingCount", followingCount)
                            .putStringSet(
                                    "followingUsers",
                                    new HashSet<>(followingUsers)
                            )
                            .apply();
                });

                row.addView(
                        info,
                        new LinearLayout.LayoutParams(0, -2, 1)
                );
                row.addView(follow);
                results.addView(row);
            }

            if (found == 0) {
                results.addView(
                        label(
                                "\nNo users found.",
                                16,
                                secondary
                        )
                );
            }
        };

        searchInput.addTextChangedListener(
                new android.text.TextWatcher() {
                    @Override
                    public void beforeTextChanged(
                            CharSequence s,
                            int start,
                            int count,
                            int after) {
                    }

                    @Override
                    public void onTextChanged(
                            CharSequence s,
                            int start,
                            int before,
                            int count) {
                        renderResults.run();
                    }

                    @Override
                    public void afterTextChanged(
                            android.text.Editable s) {
                    }
                }
        );

        renderResults.run();
    }

