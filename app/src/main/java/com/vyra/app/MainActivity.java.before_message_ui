        theme.setTextSize(16);
        content.addView(theme);

        theme.setOnClickListener(v -> {
            darkMode = !darkMode;

            profilePrefs.edit()
                    .putBoolean("darkMode", darkMode)
                    .apply();

            applyTheme();
            showSettings();
        });

        Button color = new Button(this);
        color.setText("🎨  App Color");
        color.setTextSize(16);
        content.addView(color);

        color.setOnClickListener(v -> {
            String[] names = {"Purple", "Blue", "Green", "Orange", "Pink"};
            int[] colors = {
                Color.rgb(124, 58, 237),
                Color.rgb(37, 99, 235),
                Color.rgb(22, 163, 74),
                Color.rgb(234, 88, 12),
                Color.rgb(219, 39, 119)
            };

            new android.app.AlertDialog.Builder(this)
                    .setTitle("Choose VYRA Color")
                    .setItems(names, (dialog, which) -> {
                        purple = colors[which];

                        profilePrefs.edit()
                                .putInt("appColor", purple)
                                .apply();
                        showSettings();
                    })
                    .show();
        });

        TextView privacy = label("🔒  Privacy", 18, text);
        content.addView(privacy);

        android.widget.Switch privateSwitch = new android.widget.Switch(this);
        privateSwitch.setText("Private Account");
        privateSwitch.setTextSize(16);
        privateSwitch.setChecked(privateAccount);
        privateSwitch.setPadding(20, 12, 20, 12);
        content.addView(privateSwitch);

        privateSwitch.setOnCheckedChangeListener((buttonView, isChecked) -> {
            privateAccount = isChecked;

            profilePrefs.edit()
                    .putBoolean("privateAccount", privateAccount)
                    .apply();
        });

        TextView notifications = label("🔔  Notifications", 18, text);
        content.addView(notifications);

        android.widget.Switch notificationSwitch = new android.widget.Switch(this);
        notificationSwitch.setText("Allow Notifications");
        notificationSwitch.setTextSize(16);
        notificationSwitch.setChecked(notificationsEnabled);
        notificationSwitch.setPadding(20, 12, 20, 12);
        content.addView(notificationSwitch);

