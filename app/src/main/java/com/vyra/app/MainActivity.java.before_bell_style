    private String generateUsername(String name) {
        String base = name == null ? "" : name.toLowerCase()
                .replaceAll("[^a-z0-9]", "");

        if (base.isEmpty()) {
            base = "vyrauser";
        }

        String[] reserved = {
                "vyra_creator",
                "travel_vyra",
                "foodie_vyra",
                "tech_vyra",
                "music_vyra"
        };

        String username = base;
        int number = 2;

        while (isUsernameReserved(username, reserved)) {
            username = base + number;
            number++;
        }

        return username;
    }

    private boolean isUsernameReserved(String username, String[] reserved) {
        for (String item : reserved) {
            if (item.equalsIgnoreCase(username)) {
                return true;
            }
        }
        return false;
    }

