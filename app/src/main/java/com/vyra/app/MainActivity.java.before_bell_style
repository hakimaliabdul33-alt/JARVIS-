    private void startNotificationListener() {
        if (notificationRegistration != null) {
            notificationRegistration.remove();
            notificationRegistration = null;
        }

        if (firebaseAuth == null
                || firebaseAuth.getCurrentUser() == null
                || firestore == null) {
            return;
        }

        String uid = firebaseAuth.getCurrentUser().getUid();

        notificationRegistration = firestore.collection("notifications")
                .whereEqualTo("userId", uid)
                .addSnapshotListener((snapshots, error) -> {
                    if (error != null || snapshots == null) {
                        return;
                    }

                    for (com.google.firebase.firestore.DocumentChange change
                            : snapshots.getDocumentChanges()) {

                        if (change.getType()
                                != com.google.firebase.firestore.DocumentChange.Type.ADDED) {
                            continue;
                        }

                        com.google.firebase.firestore.DocumentSnapshot doc =
                                change.getDocument();

                        String message = doc.getString("message");
                        if (message == null || message.trim().isEmpty()) {
                            message = "New activity on your VYRA post.";
                        }

                        String postId = doc.getString("postId");

                        String notificationId = doc.getId();
                        String seenKey = "firestore_notification_seen_" + notificationId;

                        if (!profilePrefs.getBoolean(seenKey, false)) {
                            addNotificationWithPostId(message, postId);

                            profilePrefs.edit()
                                    .putBoolean(seenKey, true)
                                    .apply();
                        }
                    }
                });
    }

