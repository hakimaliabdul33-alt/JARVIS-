        inputRow.setGravity(Gravity.CENTER_VERTICAL);

        final android.widget.EditText input =
                new android.widget.EditText(this);
        input.setHint("Write a comment...");
        input.setSingleLine(true);

        Button send = new Button(this);
        send.setText("Send");

        inputRow.addView(input,
                new LinearLayout.LayoutParams(0, -2, 1));
        inputRow.addView(send);
        content.addView(inputRow);

        LinearLayout commentsList = new LinearLayout(this);
        commentsList.setOrientation(LinearLayout.VERTICAL);
        content.addView(commentsList);

        final java.util.HashMap<String, View> commentViews =
                new java.util.HashMap<>();

        final com.google.firebase.firestore.ListenerRegistration[] registration =
                new com.google.firebase.firestore.ListenerRegistration[1];

        registration[0] = firestore.collection("comments")
                .whereEqualTo("postId", postId)
                .addSnapshotListener((snapshots, error) -> {
                    if (error != null || snapshots == null) {
                        commentsList.removeAllViews();
                        commentsList.addView(
                                label("\nUnable to load comments right now.",
                                        16, secondary)
                        );
                        return;
                    }

                    commentsList.removeAllViews();
                    commentViews.clear();

                    java.util.ArrayList<com.google.firebase.firestore.DocumentSnapshot> docs =
                            new java.util.ArrayList<>();

                    for (com.google.firebase.firestore.DocumentSnapshot doc
                            : snapshots.getDocuments()) {
                        docs.add(doc);
                    }

                    java.util.Collections.sort(
                            docs,
                            (a, b) -> {
                                com.google.firebase.Timestamp ta =
                                        a.getTimestamp("createdAt");
                                com.google.firebase.Timestamp tb =
                                        b.getTimestamp("createdAt");

                                if (ta == null && tb == null) return 0;
                                if (ta == null) return -1;
                                if (tb == null) return 1;
                                return ta.compareTo(tb);
                            }
                    );

                    if (docs.isEmpty()) {
                        commentsList.addView(
                                label("\nNo comments yet. Be the first to comment!",
                                        16, secondary)
                        );
                        return;
                    }

                    String currentUid =
                            firebaseAuth != null
                                    && firebaseAuth.getCurrentUser() != null
                                    ? firebaseAuth.getCurrentUser().getUid()
                                    : "";

                    for (com.google.firebase.firestore.DocumentSnapshot doc : docs) {
                        String commentText = doc.getString("text");
                        String username = doc.getString("username");
                        String displayName = doc.getString("displayName");
                        String senderUid = doc.getString("userId");

                        if (commentText == null) commentText = "";
                        if (username == null || username.trim().isEmpty()) {
                            username = "vyrauser";
                        }
                        if (displayName == null || displayName.trim().isEmpty()) {
                            displayName = username;
                        }

                        LinearLayout item = new LinearLayout(this);
                        item.setOrientation(LinearLayout.VERTICAL);
                        item.setPadding(8, 12, 8, 12);

                        TextView nameView = label(
                                "👤  " + displayName + "  @" + username,
                                15, text);
                        nameView.setTypeface(Typeface.DEFAULT, Typeface.BOLD);

                        TextView textView = label(
                                commentText,
                                16, text);
                        textView.setPadding(28, 4, 4, 4);

                        item.addView(nameView);
                        item.addView(textView);

                        if (!currentUid.isEmpty()
                                && currentUid.equals(senderUid)) {
                            Button delete = new Button(this);
                            delete.setText("Delete");
                            delete.setAllCaps(false);

                            final String commentId = doc.getId();
                            delete.setOnClickListener(v ->
                                    firestore.collection("comments")
                                            .document(commentId)
                                            .delete()
                                            .addOnFailureListener(e ->
                                                    android.widget.Toast.makeText(
                                                            this,
                                                            "Unable to delete comment",
                                                            android.widget.Toast.LENGTH_SHORT
                                                    ).show()
                                            )
                            );

                            item.addView(delete);
                        }

                        commentsList.addView(item);
                        commentViews.put(doc.getId(), item);
                    }

                    // Notify the current user when another user comments
                    // on their own post while this real-time comments listener
                    // is active.
                    for (com.google.firebase.firestore.DocumentSnapshot doc : docs) {
                        String senderUid = doc.getString("userId");
                        String targetOwnerUid = doc.getString("ownerUid");
                        boolean isOwnComment =
                                currentUid != null && currentUid.equals(senderUid);

                        if (!isOwnComment
                                && currentUid != null
                                && currentUid.equals(targetOwnerUid)) {
                            String notificationKey =
                                    "comment_seen_" + doc.getId();

                            if (!profilePrefs.getBoolean(notificationKey, false)) {
                                String commenter = doc.getString("displayName");
                                if (commenter == null || commenter.trim().isEmpty()) {
                                    commenter = doc.getString("username");
                                }
                                if (commenter == null || commenter.trim().isEmpty()) {
                                    commenter = "Someone";
                                }

                                addNotification(
                                        commenter + " commented on your VYRA post."
                                );

                                profilePrefs.edit()
                                        .putBoolean(notificationKey, true)
                                        .apply();
                            }
                        }
                    }
                });

        send.setOnClickListener(v -> {
            String value = input.getText().toString().trim();
            if (value.isEmpty()) {
                return;
            }

            String uid =
                    firebaseAuth != null
                            && firebaseAuth.getCurrentUser() != null
                            ? firebaseAuth.getCurrentUser().getUid()
                            : "guest";

            java.util.HashMap<String, Object> commentData =
                    new java.util.HashMap<>();
            commentData.put("postId", postId);
            commentData.put("ownerUid", ownerUid == null ? "" : ownerUid);
            commentData.put("userId", uid);
            commentData.put("username", profileUsername);
            commentData.put("displayName", profileName);
            commentData.put("text", value);
            commentData.put(
                    "createdAt",
                    com.google.firebase.firestore.FieldValue.serverTimestamp()
            );

            send.setEnabled(false);

            firestore.collection("comments")
                    .add(commentData)
                    .addOnSuccessListener(doc -> {
                        input.setText("");

                        if (ownerUid != null
                                && !ownerUid.trim().isEmpty()
                                && !ownerUid.equals(uid)
                                && !"guest".equals(uid)) {

                            java.util.HashMap<String, Object> notificationData =
                                    new java.util.HashMap<>();

                            notificationData.put("userId", ownerUid);
                            notificationData.put("senderId", uid);
                            notificationData.put("type", "comment");
                            notificationData.put("postId", postId);
                            notificationData.put(
                                    "message",
                                    profileName + " commented on your VYRA post."
                            );
                            notificationData.put(
                                    "createdAt",
                                    com.google.firebase.firestore.FieldValue.serverTimestamp()
                            );

                            firestore.collection("notifications")
                                    .add(notificationData);
                        }

                        addNotification("You added a comment.");
                        send.setEnabled(true);
                    })
                    .addOnFailureListener(e -> {
                        send.setEnabled(true);
                        android.widget.Toast.makeText(
                                this,
                                "Comment failed. Please try again.",
                                android.widget.Toast.LENGTH_SHORT
                        ).show();
                    });
        });
    }
}
