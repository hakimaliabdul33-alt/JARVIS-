    private void showChat(String otherUid, String username, String displayName) {
        if (firebaseAuth.getCurrentUser() == null) {
            showAuth();
            return;
        }

        final String myUid = firebaseAuth.getCurrentUser().getUid();
        final String conversationId = getConversationId(myUid, otherUid);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setBackgroundColor(Color.BLACK);

        LinearLayout top = new LinearLayout(this);
        top.setGravity(Gravity.CENTER_VERTICAL);
        top.setPadding(12, 12, 12, 12);
        top.setBackgroundColor(Color.BLACK);

        TextView back = label("‹", 36, Color.WHITE);
        back.setGravity(Gravity.CENTER);
        back.setClickable(true);
        back.setFocusable(true);
        back.setOnClickListener(v -> showMessages());
        top.addView(back, new LinearLayout.LayoutParams(52, 58));

        LinearLayout titleBox = new LinearLayout(this);
        titleBox.setOrientation(LinearLayout.VERTICAL);

        TextView title = label(displayName, 20, Color.WHITE);
        title.setTypeface(Typeface.DEFAULT, Typeface.BOLD);

        TextView user = label("@" + username, 13, Color.GRAY);

        titleBox.addView(title);
        titleBox.addView(user);

        top.addView(
                titleBox,
                new LinearLayout.LayoutParams(0, -2, 1)
        );

        root.addView(top);

        View divider = new View(this);
        divider.setBackgroundColor(Color.rgb(38, 38, 38));
        root.addView(
                divider,
                new LinearLayout.LayoutParams(-1, 1)
        );

        android.widget.ScrollView scroll =
                new android.widget.ScrollView(this);
        scroll.setBackgroundColor(Color.BLACK);

        LinearLayout messagesBox = new LinearLayout(this);
        messagesBox.setOrientation(LinearLayout.VERTICAL);
        messagesBox.setPadding(16, 16, 16, 16);

        scroll.addView(messagesBox);

        root.addView(
                scroll,
                new LinearLayout.LayoutParams(1, 0, 1)
        );

        LinearLayout inputRow = new LinearLayout(this);
        inputRow.setGravity(Gravity.CENTER_VERTICAL);
        inputRow.setPadding(10, 8, 10, 8);
        inputRow.setBackgroundColor(Color.rgb(18, 18, 18));

        final EditText input = new EditText(this);
        input.setHint("Write a message...");
        input.setHintTextColor(Color.GRAY);
        input.setTextColor(Color.WHITE);
        input.setSingleLine(true);

        Button send = new Button(this);
        send.setText("Send");
        send.setTextSize(14);

        inputRow.addView(
                input,
                new LinearLayout.LayoutParams(0, -2, 1)
        );
        inputRow.addView(send);

        root.addView(
                inputRow,
                new LinearLayout.LayoutParams(-1, -2)
        );

        setContentView(root);

        firestore.collection("conversations")
                .document(conversationId)
                .get()
                .addOnSuccessListener(snapshot -> {
                    if (!snapshot.exists()) {
                        java.util.Map<String, Object> conversation =
                                new java.util.HashMap<>();

                        java.util.ArrayList<String> participants =
                                new java.util.ArrayList<>();
                        participants.add(myUid);
                        participants.add(otherUid);

                        conversation.put("participants", participants);
                        conversation.put("lastMessage", "");
                        conversation.put("lastSenderId", "");
                        conversation.put(
                                "createdAt",
                                com.google.firebase.firestore.FieldValue.serverTimestamp()
                        );
                        conversation.put(
                                "updatedAt",
                                com.google.firebase.firestore.FieldValue.serverTimestamp()
                        );

                        firestore.collection("conversations")
                                .document(conversationId)
                                .set(conversation);
                    }
                });

        firestore.collection("conversations")
                .document(conversationId)
                .collection("messages")
                .orderBy(
                        "createdAt",
                        com.google.firebase.firestore.Query.Direction.ASCENDING
                )
                .addSnapshotListener((snapshot, error) -> {
                    if (error != null) {
                        messagesBox.removeAllViews();

                        TextView errorView = label(
                                "Unable to load messages. Check your connection.",
                                15,
                                Color.GRAY
                        );
                        errorView.setGravity(Gravity.CENTER);
                        messagesBox.addView(errorView);
                        return;
                    }

                    messagesBox.removeAllViews();

                    if (snapshot == null || snapshot.isEmpty()) {
                        TextView welcome = label(
                                "Start a conversation with " + displayName,
                                15,
                                Color.GRAY
                        );
                        welcome.setGravity(Gravity.CENTER);
                        messagesBox.addView(welcome);
                        return;
                    }

                    for (
                            com.google.firebase.firestore.QueryDocumentSnapshot doc
                            : snapshot
                    ) {
                        String messageText = doc.getString("text");
                        String senderId = doc.getString("senderId");

                        if (messageText == null) {
                            messageText = "";
                        }

                        boolean mine = myUid.equals(senderId);

                        TextView messageView = label(
                                (mine ? "You: " : displayName + ": ")
                                        + messageText,
                                16,
                                Color.WHITE
                        );

                        messageView.setPadding(14, 10, 14, 10);
                        messagesBox.addView(messageView);
                    }

                    scroll.post(() ->
                            scroll.fullScroll(
                                    android.view.View.FOCUS_DOWN
                            )
                    );
                });

        send.setOnClickListener(v -> {
            String message = input.getText().toString().trim();

            if (message.isEmpty()) {
                return;
            }

            java.util.Map<String, Object> messageData =
                    new java.util.HashMap<>();

            messageData.put("senderId", myUid);
            messageData.put("receiverId", otherUid);
            messageData.put("text", message);
            messageData.put(
                    "createdAt",
                    com.google.firebase.firestore.FieldValue.serverTimestamp()
            );

            java.util.Map<String, Object> conversationData =
                    new java.util.HashMap<>();

            java.util.ArrayList<String> participants =
                    new java.util.ArrayList<>();
            participants.add(myUid);
            participants.add(otherUid);

            conversationData.put("participants", participants);
            conversationData.put("lastMessage", message);
            conversationData.put("lastSenderId", myUid);
            conversationData.put(
                    "updatedAt",
                    com.google.firebase.firestore.FieldValue.serverTimestamp()
            );

            firestore.collection("conversations")
                    .document(conversationId)
                    .set(conversationData,
                            com.google.firebase.firestore.SetOptions.merge())
                    .addOnSuccessListener(unused -> {

                        firestore.collection("conversations")
                                .document(conversationId)
                                .collection("messages")
                                .add(messageData)
                                .addOnSuccessListener(doc -> {
                                    input.setText("");

                                    scroll.post(() ->
                                            scroll.fullScroll(
                                                    android.view.View.FOCUS_DOWN
                                            )
                                    );
                                })
                                .addOnFailureListener(e ->
                                        android.widget.Toast.makeText(
                                                this,
                                                "Message failed: "
                                                        + e.getMessage(),
                                                android.widget.Toast.LENGTH_LONG
                                        ).show()
                                );
                    })
                    .addOnFailureListener(e ->
                            android.widget.Toast.makeText(
                                    this,
                                    "Chat permission failed: "
                                            + e.getMessage(),
                                    android.widget.Toast.LENGTH_LONG
                            ).show()
                    );
        });
    }

