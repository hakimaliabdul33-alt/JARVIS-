        scroll.setBackgroundColor(Color.BLACK);

        LinearLayout list = new LinearLayout(this);
        list.setOrientation(LinearLayout.VERTICAL);
        list.setPadding(8, 0, 8, 20);

        scroll.addView(list);

        root.addView(
                scroll,
                new LinearLayout.LayoutParams(-1, 0, 1)
        );

        LinearLayout nav = new LinearLayout(this);
        nav.setGravity(Gravity.CENTER);
        nav.setPadding(4, 4, 4, 4);
        nav.setBackgroundColor(Color.BLACK);

        TextView home = navItem("⌂", "Home");
        TextView messages = navItem("▱", "Message");
        TextView upload = navItem("⊕", "Upload");
        TextView account = navItem("♙", "Account");

        messages.setTextColor(purple);

        home.setOnClickListener(v -> showHome());
        messages.setOnClickListener(v -> showMessages());
        upload.setOnClickListener(v -> showShorts());
        account.setOnClickListener(v -> showProfile());

        nav.addView(home, new LinearLayout.LayoutParams(0, 82, 1));
        nav.addView(messages, new LinearLayout.LayoutParams(0, 82, 1));
        nav.addView(upload, new LinearLayout.LayoutParams(0, 82, 1));
        nav.addView(account, new LinearLayout.LayoutParams(0, 82, 1));

        root.addView(nav);

        setContentView(root);

        firestore.collection("conversations")
                .whereArrayContains("participants", myUid)
                .addSnapshotListener((snapshot, error) -> {
                    list.removeAllViews();

                    if (error != null) {
                        TextView errorView = label(
                                "Unable to load messages. Check your connection.",
                                15,
                                Color.GRAY
                        );
                        errorView.setGravity(Gravity.CENTER);
                        errorView.setPadding(20, 30, 20, 30);
                        list.addView(errorView);
                        return;
                    }

                    if (snapshot == null || snapshot.isEmpty()) {
                        TextView empty = label(
                                "No messages yet\nSearch for a VYRA user to start chatting.",
                                16,
                                Color.GRAY
                        );
                        empty.setGravity(Gravity.CENTER);
                        empty.setPadding(20, 60, 20, 60);
                        list.addView(empty);
                        return;
                    }

                    java.util.ArrayList<com.google.firebase.firestore.DocumentSnapshot>
                            conversations =
                            new java.util.ArrayList<>();

                    for (com.google.firebase.firestore.DocumentSnapshot doc
                            : snapshot.getDocuments()) {
                        conversations.add(doc);
                    }

                    java.util.Collections.sort(
                            conversations,
                            (a, b) -> {
                                com.google.firebase.Timestamp ta =
                                        a.getTimestamp("updatedAt");
                                com.google.firebase.Timestamp tb =
                                        b.getTimestamp("updatedAt");

                                if (ta == null && tb == null) return 0;
                                if (ta == null) return 1;
                                if (tb == null) return -1;

                                return tb.compareTo(ta);
                            }
                    );

                    for (com.google.firebase.firestore.DocumentSnapshot conversation
                            : conversations) {

                        java.util.List<String> participants =
                                (java.util.List<String>)
                                        conversation.get("participants");

                        if (participants == null) continue;

                        String otherUid = null;

                        for (String participant : participants) {
                            if (!myUid.equals(participant)) {
                                otherUid = participant;
                                break;
                            }
                        }

                        if (otherUid == null || otherUid.trim().isEmpty()) {
                            continue;
                        }

