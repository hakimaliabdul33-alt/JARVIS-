    private void addNotificationWithPostId(String message, String postId) {
        String safePostId = postId == null ? "" : postId.trim();
        String stored = safePostId.isEmpty()
                ? message
                : "__VYRA_POST__" + safePostId + "__VYRA_MSG__" + message;

        localNotifications.add(stored);
        unreadNotifications++;

        profilePrefs.edit()
                .putStringSet(
                        "localNotifications",
                        new HashSet<>(localNotifications)
                )
                .putInt("unreadNotifications", unreadNotifications)
                .apply();
    }

    private String getNotificationMessage(String notification) {
        if (notification == null) return "";
        int marker = notification.indexOf("__VYRA_MSG__");

        if (notification.startsWith("__VYRA_POST__") && marker >= 0) {
            return notification.substring(marker + "__VYRA_MSG__".length());
        }

        return notification;
    }

    private String getNotificationPostId(String notification) {
        if (notification == null
                || !notification.startsWith("__VYRA_POST__")) {
            return "";
        }

        int start = "__VYRA_POST__".length();
        int marker = notification.indexOf("__VYRA_MSG__", start);

        if (marker < 0) return "";

        return notification.substring(start, marker);
    }

